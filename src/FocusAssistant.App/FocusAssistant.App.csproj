<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exe rather than WinExe: the app logs diagnostics with Console.WriteLine,
         and WinExe would discard all of it. -->
    <OutputType>Exe</OutputType>
    <!-- net10.0-windows: this machine (and most current dev/user machines) has the
         .NET 10 desktop runtime but not .NET 8, which is why the previous target
         only ran under DOTNET_ROLL_FORWARD. .NET 10 is LTS. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FocusAssistant</AssemblyName>
    <RootNamespace>FocusAssistant</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FocusAssistant.Core\FocusAssistant.Core.csproj" />
    <ProjectReference Include="..\FocusAssistant.Data\FocusAssistant.Data.csproj" />
    <ProjectReference Include="..\FocusAssistant.Platform\FocusAssistant.Platform.csproj" />
    <ProjectReference Include="..\FocusAssistant.Intelligence\FocusAssistant.Intelligence.csproj" />
  </ItemGroup>

</Project>
