<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: diagnostics go to a rolling file under LocalAppData now, so there is
         no reason to ship a console window alongside the app. -->
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows: this machine (and most current dev/user machines) has the
         .NET 10 desktop runtime but not .NET 8, which is why the previous target
         only ran under DOTNET_ROLL_FORWARD. .NET 10 is LTS. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon: WPF has never shipped one and WPF-UI removed its own in
         v4, so WinForms' NotifyIcon is the standard way to put an app in the tray. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FocusAssistant</AssemblyName>
    <RootNamespace>FocusAssistant</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds System.Drawing to the implicit usings (not
         System.Windows.Forms, which needed no removal), which then collides with WPF's
         System.Windows.Media/System.Windows across the app on Point, Brush, Color, Pen,
         Size and FontFamily. Only the tray icon and its icon loading need System.Drawing,
         and that file imports the namespace itself. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.json is read from AppContext.BaseDirectory at startup. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FocusAssistant.Core\FocusAssistant.Core.csproj" />
    <ProjectReference Include="..\FocusAssistant.Data\FocusAssistant.Data.csproj" />
    <ProjectReference Include="..\FocusAssistant.Platform\FocusAssistant.Platform.csproj" />
    <ProjectReference Include="..\FocusAssistant.Intelligence\FocusAssistant.Intelligence.csproj" />
  </ItemGroup>

</Project>
