<UserControl x:Class="FocusAssistant.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Date Picker -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Select Date:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker SelectedDate="{Binding SelectedDate}" Width="150"/>
        </StackPanel>

        <!-- Analytics Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Statistics -->
            <GroupBox Grid.Column="0" Header="Session Statistics" Margin="0,0,10,0">
                <StackPanel Margin="10">
                    <TextBlock Text="{Binding Statistics.TotalSessions, StringFormat='Total Sessions: {0}'}" Margin="0,5"/>
                    <TextBlock Text="{Binding Statistics.TotalWorkTime, StringFormat='Total Work Time: {0:hh\\:mm\\:ss}'}" Margin="0,5"/>
                    <TextBlock Text="{Binding Statistics.TotalProductiveTime, StringFormat='Productive Time: {0:hh\\:mm\\:ss}'}" Margin="0,5"/>
                    <TextBlock Text="{Binding Statistics.TotalDistractedTime, StringFormat='Distracted Time: {0:hh\\:mm\\:ss}'}" Margin="0,5"/>
                    <TextBlock Text="{Binding Statistics.TotalBreakTime, StringFormat='Break Time: {0:hh\\:mm\\:ss}'}" Margin="0,5"/>
                    <TextBlock Text="{Binding Statistics.AverageSessionLength, StringFormat='Avg Session Length: {0:hh\\:mm\\:ss}'}" Margin="0,5"/>
                    <TextBlock Text="{Binding Statistics.ProductivityScore, StringFormat='Productivity Score: {0:F2}%'}" Margin="0,5"/>
                    <TextBlock Text="{Binding Statistics.TotalAppSwitches, StringFormat='App Switches: {0}'}" Margin="0,5"/>
                </StackPanel>
            </GroupBox>

            <!-- Top Apps -->
            <GroupBox Grid.Column="1" Header="Top Apps">
                <ListBox ItemsSource="{Binding TopApps}" Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <!-- Named properties, not Item1/Item2: the list held
                                     ValueTuples, whose members are fields, and WPF
                                     bindings only see properties. -->
                                <TextBlock Text="{Binding AppName}" Width="200" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Duration, StringFormat='Duration: {0:hh\\:mm\\:ss}'}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>

        <!-- Download Button -->
        <Button Grid.Row="2" Content="Download Report" Command="{Binding DownloadReportCommand}" 
                Width="150" Height="30" Margin="0,20,0,0" HorizontalAlignment="Right"/>
    </Grid>
</UserControl>