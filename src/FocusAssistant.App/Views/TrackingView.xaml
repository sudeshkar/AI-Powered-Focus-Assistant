<Page x:Class="FocusAssistant.Views.TrackingView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1000">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ProductiveDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#2EA043"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProductive}" Value="False">
                    <Setter Property="Fill" Value="#C05B4A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

        <StackPanel Margin="8,8,20,32">

            <TextBlock Text="Focus" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Opacity="0.75" Margin="0,0,0,18" FontSize="14"
                       Text="Tracking runs automatically in the background. Set a goal so nudges and summaries know what you're working on."/>

            <!-- Goal -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="What are you working on?" Style="{StaticResource SectionTitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" x:Name="GoalBox"
                                    Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="e.g. finish the API documentation"
                                    FontSize="14" VerticalContentAlignment="Center"/>

                        <ui:Button Grid.Column="1" Content="Start focus session" Appearance="Primary"
                                   Margin="10,0,0,0" Command="{Binding StartFocusSessionCommand}"/>
                    </Grid>

                    <Grid Margin="0,12,0,0" Visibility="{Binding HasActiveGoal, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Target24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" FontSize="13">
                                <Run Text="Current goal: " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Run Text="{Binding ActiveGoal}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                        <ui:Button Content="Clear" Appearance="Transparent" HorizontalAlignment="Right"
                                   FontSize="12" Padding="8,2" Command="{Binding ClearGoalCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Live status -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Right now" Style="{StaticResource SectionTitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Style="{StaticResource ProductiveDot}"
                                 Margin="0,4,12,0" VerticalAlignment="Top"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                <Run Text="{Binding CurrentApp, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentWindow}" Opacity="0.65" FontSize="13"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock Opacity="0.55" FontSize="12" Margin="0,6,0,0" FontStyle="Italic">
                                <Run Text="{Binding CurrentRationale, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Activity log -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Recent activity" Style="{StaticResource SectionTitle}"/>

                    <ItemsControl ItemsSource="{Binding ActivityLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Style="{StaticResource ProductiveDot}"
                                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" Opacity="0.55"
                                               FontSize="12" Width="60" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AppName}" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding WindowTitle}" Opacity="0.6"
                                               FontSize="12" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" Opacity="0.7"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Nothing recorded yet - it appears here as soon as you switch windows."
                               Opacity="0.55" FontStyle="Italic" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivityLog.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
</Page>
