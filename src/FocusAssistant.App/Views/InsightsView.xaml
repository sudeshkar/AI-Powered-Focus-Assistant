<Page x:Class="FocusAssistant.Views.InsightsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:FocusAssistant.Converters"
      xmlns:vm="clr-namespace:FocusAssistant.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1000">

    <Page.Resources>
        <conv:HourlyFocusToBrushConverter x:Key="HourToBrush"/>
        <conv:ShareToWidthConverter x:Key="ShareToWidth"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <ObjectDataProvider x:Key="Periods" MethodName="GetValues" ObjectType="{x:Type sys:Enum}"
                             xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:InsightsPeriod"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- A thin bar at the top, the way a browser shows page-load progress: visible
             only while a real reload is happening (RefreshGate skips this entirely on a
             cached revisit), and it never covers the existing content, so switching back
             to a tab whose data is still fresh shows that data immediately with no bar at
             all, while a genuine reload reads as "working" instead of "stuck". -->
        <ProgressBar Height="2" VerticalAlignment="Top" Panel.ZIndex="1"
                     IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="8,8,8,24">

            <Grid Margin="0,0,0,18">
                <TextBlock Text="Insights" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox HorizontalAlignment="Right" Width="140"
                          ItemsSource="{Binding Source={StaticResource Periods}}"
                          SelectedItem="{Binding Period}"/>
            </Grid>

            <!-- Summary tiles -->
            <Border Style="{StaticResource Card}">
                <UniformGrid Rows="1" Columns="5">
                    <StackPanel>
                        <TextBlock Text="Focus score" Style="{StaticResource TileLabel}"/>
                        <TextBlock Text="{Binding FocusScore}" Style="{StaticResource TileValue}"/>
                        <TextBlock Text="{Binding ScoreBand}" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Focused" Style="{StaticResource TileLabel}"/>
                        <TextBlock Text="{Binding FocusedTime}" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Distracted" Style="{StaticResource TileLabel}"/>
                        <TextBlock Text="{Binding DistractedTime}" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Longest stretch" Style="{StaticResource TileLabel}"/>
                        <TextBlock Text="{Binding LongestStretch}" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Days tracked" Style="{StaticResource TileLabel}"/>
                        <TextBlock Text="{Binding DaysWithActivity}" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Hourly pattern -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="When you're sharpest" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding HourlyPattern}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="24"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="1" CornerRadius="2" Height="40"
                                        Background="{Binding Converter={StaticResource HourToBrush}}"
                                        ToolTip="{Binding Label}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="12am" Opacity="0.55" FontSize="11" HorizontalAlignment="Left"/>
                        <TextBlock Text="12pm" Opacity="0.55" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="11pm" Opacity="0.55" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Distraction sources + observations -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Biggest distractions" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding DistractionSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding Time}" FontSize="13" Opacity="0.65" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Rectangle Grid.Row="1" Height="6" RadiusX="3" RadiusY="3"
                                                   Margin="0,4,0,0" HorizontalAlignment="Left" Fill="#C05B4A"
                                                   Width="{Binding Share, Converter={StaticResource ShareToWidth}, ConverterParameter=300}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No distractions recorded in this period." Opacity="0.55" FontStyle="Italic" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DistractionSources.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Observations" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16"
                                             HorizontalAlignment="Right" VerticalAlignment="Center"
                                             Visibility="{Binding IsWritingObservations, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <TextBlock Text="{Binding Observations}" TextWrapping="Wrap" LineHeight="21" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Export -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:Button Content="Export today's report (CSV)" Command="{Binding DownloadReportCommand}"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" FontSize="12"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
