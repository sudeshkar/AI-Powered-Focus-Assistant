<Application x:Class="FocusAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:FocusAssistant">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- No explicit Theme here: which palette (light/dark) is actually loaded
                     is decided at runtime by SystemThemeWatcher.Watch, called from
                     MainWindow's constructor, which also keeps it in sync with the OS
                     setting while the app is running. -->
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- WPF-UI deliberately does not style plain TextBlock, so every TextBlock in
                 every view fell back to WPF's hardcoded default Foreground=Black. That read
                 fine by accident in the light palette and was invisible the moment dark mode
                 actually started applying (see MainWindow's SystemThemeWatcher.Watch) - dark
                 backgrounds with black text on top of them. One implicit style, theme-aware
                 via the same token WPF-UI's own controls use, fixes every view at once
                 instead of hand-adding Foreground to each TextBlock in each page. -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
