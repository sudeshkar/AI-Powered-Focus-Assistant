{
  "Monitoring": {
    "WindowPollInterval": "00:00:02",
    "IdleThreshold": "00:02:00",
    "MinimumUsageDuration": "00:00:02"
  },
  "Intelligence": {
    "EnableSemanticClassifier": true,
    "MinimumSimilarity": 0.12,
    "MinimumMargin": 0.06,
    "SlmIdleUnloadTimeout": "00:10:00"
  },
  "Privacy": {
    "RetentionDays": 90,
    "TitleCapture": "Full",
    "ExcludedProcesses": [ "1Password", "Bitwarden", "KeePass", "KeePassXC", "Dashlane", "LastPass" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
