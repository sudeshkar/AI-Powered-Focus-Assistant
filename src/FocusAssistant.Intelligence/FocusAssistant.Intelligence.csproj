<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FocusAssistant.Intelligence</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.15.2" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FocusAssistant.Core\FocusAssistant.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The MiniLM model is ~23MB and committed to the repository: the classifier is
         useless without it, so a fresh clone has to build and run as-is. The 2.5GB
         language model is the opposite case and is downloaded on first use. -->
    <None Include="..\..\models\minilm\**" LinkBase="Models\minilm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\**" LinkBase="Assets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
