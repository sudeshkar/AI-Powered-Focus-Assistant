<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No platform dependency on purpose: this is what makes the focus
         engine unit-testable without a desktop or Win32. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FocusAssistant.Core</RootNamespace>
  </PropertyGroup>

</Project>
