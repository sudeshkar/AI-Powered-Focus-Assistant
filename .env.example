# Copy this file to .env and adjust as needed.
# .env is gitignored — never commit real configuration.

# ---- Flask API ----
# The WPF client reads the same host/port to reach the backend.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Leave off unless you are debugging the backend. The Werkzeug debugger
# exposes an interactive console and spawns a reloader child process,
# which the WPF client cannot shut down cleanly.
FLASK_DEBUG=false

# ---- RL agent ----
# Directory holding enhanced_focus_rl_model.json / .pkl.
# Relative paths resolve against Python_Backend/.
MODEL_DIR=models

# Save the model to disk after this many feedback events.
MODEL_SAVE_INTERVAL=10

# Keep at most this many timestamped model backups (0 disables backups).
MODEL_BACKUP_LIMIT=5
