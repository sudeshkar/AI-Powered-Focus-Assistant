<Window x:Class="FocusAssistant.Views.AiInterventionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Intervention"
        Height="250" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Topmost="True"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="AiMessageTextBlock"
                   Grid.Row="0"
                   Text="AI message will appear here..."
                   FontSize="16"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,0,0,10"
                   MaxHeight="60"/>

        <TextBlock x:Name="SuggestionText"
                   Grid.Row="1"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   FontSize="14"
                   VerticalAlignment="Top"
                   Margin="0,0,0,10"
                   MaxHeight="80"/>

        <WrapPanel Grid.Row="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,10,0,0">
            <Button Content="Act Now" Width="80" Margin="5" Click="ActNow_Click"/>
            <Button Content="Later" Width="80" Margin="5" Click="ActLater_Click"/>
            <Button Content="Dismiss" Width="80" Margin="5" Click="Dismiss_Click"/>
            <Button Content="Ignore" Width="80" Margin="5" Click="Ignore_Click"/>
        </WrapPanel>
    </Grid>
</Window>