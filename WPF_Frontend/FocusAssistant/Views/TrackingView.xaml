<UserControl x:Class="FocusAssistant.Views.TrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:local="clr-namespace:FocusAssistant.ViewModels"
            mc:Ignorable="d"
            d:DesignHeight="600" d:DesignWidth="800"
            Height="600" Width="800">   


    <UserControl.Resources>
        <!-- Metallic Gradient Brushes -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3d52a0" Offset="0"/>
            <GradientStop Color="#7091e6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SecondaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8697c4" Offset="0"/>
            <GradientStop Color="#adbbda" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LightGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ede8f5" Offset="0"/>
            <GradientStop Color="#adbbda" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7091e6" Offset="0"/>
            <GradientStop Color="#3d52a0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonHoverGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8697c4" Offset="0"/>
            <GradientStop Color="#7091e6" Offset="1"/>
        </LinearGradientBrush>

        <!-- Drop Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" ShadowDepth="4" Direction="315" Color="#33000000" Opacity="0.3" BlurRadius="8"/>
        <DropShadowEffect x:Key="ButtonShadow" ShadowDepth="2" Direction="315" Color="#33000000" Opacity="0.5" BlurRadius="4"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonHoverGradient}"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="3" Direction="315" Color="#33000000" Opacity="0.6" BlurRadius="6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="1" Direction="315" Color="#33000000" Opacity="0.4" BlurRadius="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style for sections -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Modern TextBlock Styles -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3d52a0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#7091e6"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3d52a0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Modern ListBox Style -->
        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#ede8f5"/>
            <Setter Property="BorderBrush" Value="#adbbda"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer>
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Background -->
    <Grid Background="{StaticResource LightGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryGradient}" Style="{StaticResource CardPanel}" Margin="10,10,10,5">
            <StackPanel>
                <TextBlock Text="🎯 Productivity Dashboard" Style="{StaticResource HeaderText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="▶ Start Tracking" 
                            Command="{Binding StartTrackingCommand}" 
                            Style="{StaticResource ModernButton}" 
                            Width="140"/>
                    <Button Content="⏹ Stop Tracking" 
                            Command="{Binding StopTrackingCommand}" 
                            Style="{StaticResource ModernButton}" 
                            Width="140"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Dashboard Section -->
        <Border Grid.Row="1" Background="White" Style="{StaticResource CardPanel}" Margin="10,5,10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Metrics Panel -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="📊 Performance Metrics" Style="{StaticResource SectionHeader}"/>

                    <Border Background="{StaticResource SecondaryGradient}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PRODUCTIVITY SCORE" Style="{StaticResource MetricLabel}" Foreground="White" FontSize="10"/>
                            <TextBlock Text="{Binding ProductivityScore}" Style="{StaticResource MetricValue}" Foreground="White" FontSize="20"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#ede8f5" CornerRadius="6" Padding="8" Margin="0,0,5,0" Width="80">
                            <StackPanel>
                                <TextBlock Text="ACTIVITIES" Style="{StaticResource MetricLabel}" FontSize="8" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalActivities}" Style="{StaticResource MetricValue}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#ede8f5" CornerRadius="6" Padding="8" Width="80">
                            <StackPanel>
                                <TextBlock Text="INTERVENTIONS" Style="{StaticResource MetricLabel}" FontSize="8" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding RecentInterventions}" Style="{StaticResource MetricValue}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Background="#3d52a0" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="🤖 AI Status" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text="{Binding AIStatus}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Activity Log Panel -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="📋 Activity Timeline" Style="{StaticResource SectionHeader}"/>
                    <ListBox ItemsSource="{Binding ActivityLog}" 
                             Style="{StaticResource ModernListBox}"
                             Height="220"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" 
                                        CornerRadius="6" 
                                        Padding="12" 
                                        Margin="0,2"
                                        BorderBrush="#adbbda" 
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding AppName}" 
                                                     FontWeight="SemiBold" 
                                                     FontSize="13"
                                                     Foreground="#3d52a0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" 
                                                Background="{StaticResource SecondaryGradient}"
                                                CornerRadius="10"
                                                Padding="8,3">
                                            <TextBlock Text="{Binding DurationText}" 
                                                     FontSize="10"
                                                     FontWeight="Medium"
                                                     Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Current Status Section -->
        <Border Grid.Row="2" Background="White" Style="{StaticResource CardPanel}" Margin="10,5,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Main content area -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="💻 Current Application" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource LightGradient}" CornerRadius="8" Padding="12">
                            <TextBlock Text="{Binding CurrentApp}" 
                                     FontSize="14" 
                                     FontWeight="SemiBold"
                                     Foreground="#3d52a0"
                                     TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="🖼 Active Window" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource LightGradient}" CornerRadius="8" Padding="12">
                            <TextBlock Text="{Binding CurrentWindow}" 
                                     FontSize="14" 
                                     FontWeight="SemiBold"
                                     Foreground="#3d52a0"
                                     TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Status Text at bottom -->
                <TextBlock Grid.Row="1" 
                         Text="{Binding StatusText}" 
                         FontStyle="Italic" 
                         FontSize="12"
                         Foreground="#7091e6"
                         HorizontalAlignment="Center"
                         Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>