<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exe rather than WinExe: the app logs diagnostics with Console.WriteLine,
         and WinExe would discard all of it. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.18362.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FocusAssistant</AssemblyName>
    <RootNamespace>FocusAssistant</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Removed: AWSSDK.DynamoDBv2, MailChimp.Net.V3, StackExchange.Redis,
      Microsoft.Office.Interop.Excel, LiveChartsCore.SkiaSharpView.WPF,
      System.Management and Microsoft.Toolkit.Uwp.Notifications. None of them were
      referenced by any code path — they only appeared in stray using directives.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.8" />
  </ItemGroup>

</Project>
